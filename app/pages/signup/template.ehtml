import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  handle: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm) {
  try {
    signup(form.handle, form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { handle: "", email: "", password: "", error: "" },
)>
  <Layout title="sign up">
    <div class="page-shell is-form signup-form">
      <form class="stack" onsubmit={() => onSubmit(form)}>
        <h1>Create an account</h1>

        <Alert e:if={form.error} variant="danger" description={form.error} />

        <Field label="username" description="letters, digits and underscores; shown on everything you post">
          <Input name="username"
                 value={form.handle}
                 required
                 attrs={{ id: "handle", autocomplete: "username", autocapitalize: "none", spellcheck: "false", pattern: "[A-Za-z0-9_]{2,20}" }} />
        </Field>

        <Field label="email" description="we email you when someone replies to you">
          <Input name="email"
                 type="email"
                 value={form.email}
                 required
                 attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
        </Field>

        <Field label="password" description={`at least ${MIN_PASSWORD} characters`}>
          <Input name="password"
                 type="password"
                 value={form.password}
                 required
                 attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
        </Field>

        <Button type="submit" variant="primary">create account</Button>

        <a href="/signin">have an account? sign in</a>
      </form>
    </div>
  </Layout>
</html>
