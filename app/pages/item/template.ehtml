import "./style.css";
import { LiveView, session } from "@elements/app";
import { Button } from "@elements/ui/button";
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "@elements/ui/collapsible";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { Textarea } from "@elements/ui/textarea";
import { Toggle } from "@elements/ui/toggle";
import { Layout } from "#app/shared/templates/layout";
import { VoteButton, PostTitle, PostMeta } from "#app/shared/templates/post-list";
import { Post, PostVote, ago } from "#app/shared/services/posts";
import {
  Comment,
  CommentVote,
  MAX_COMMENT,
  childrenOf,
  descendantCount,
  hasVotedComment,
  postComment,
  toggleCommentVote,
} from "#app/shared/services/comments";

interface Draft {
  body: string;
  open: boolean;
  error: string;
}

export function onReply(view: LiveView<Comment>, parentId: string | null, draft: Draft) {
  let body = draft.body.trim();

  if (!body) {
    draft.error = "write something first";
    return;
  }

  try {
    postComment(view, parentId, body, () => {
      draft.body = "";
      draft.open = false;
      draft.error = "";
    });
  } catch (err: any) {
    draft.error = err.message;
  }
}

function plural(n: number, word: string): string {
  return `${n} ${word}${n === 1 ? "" : "s"}`;
}

<CommentNode (
  c: Comment,
  all: LiveView<Comment>,
  votes: LiveView<CommentVote> | null,
  private open: boolean = true,
  private draft: Draft = { body: "", open: false, error: "" },
)>
  <li class="comment" id={`c-${c.id}`}>
    <Collapsible open={open} class="comment-fold">
      <div class="comment-head row">
        <Toggle variant="outline"
                size="sm"
                label="upvote"
                pressed={hasVotedComment(votes, c.id)}
                disabled={c.userId === session.get("userId")}
                onPressedChange={(_, details) => { details.cancel(); toggleCommentVote(votes, c.id); }}>
          <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M6 2 L11 9 H1 Z" fill="currentColor"/>
          </svg>
        </Toggle>
        <a class="comment-author" href={`/user/${c.userName}`}>{c.userName}</a>
        <span>{plural(c.score, "point")}</span>
        <span aria-hidden="true">·</span>
        <a href={`#c-${c.id}`}>{ago(c.createdAt)}</a>
        <CollapsibleTrigger>
          <Button variant="link" size="xs" class="comment-toggle">{open ? "[–]" : `[+${descendantCount(all, c.id) + 1}]`}</Button>
        </CollapsibleTrigger>
      </div>

      <CollapsibleContent class="comment-content">
        <p class="comment-body">{c.body}</p>

        <div class="comment-actions row">
          <Button e:if={session.isLoggedIn()} variant="link" size="xs" onclick={() => draft.open = !draft.open}>{draft.open ? "cancel" : "reply"}</Button>
          <a e:else href="/signin">sign in to reply</a>
        </div>

        <form e:if={draft.open} class="comment-reply stack is-sm" onsubmit={() => onReply(all, c.id, draft)}>
          <Field error={draft.error}>
            <Textarea value={draft.body} rows={4} maxlength={MAX_COMMENT} placeholder={`reply to ${c.userName}`} autoFocus attrs={{ "aria-label": "reply" }} />
          </Field>
          <div class="row">
            <Button type="submit" variant="primary" size="sm">reply</Button>
          </div>
        </form>

        <ul e:if={childrenOf(all, c.id).length > 0} class="comment-tree">
          <CommentNode e:for={child of childrenOf(all, c.id)} c={child} {all} {votes} />
        </ul>
      </CollapsibleContent>
    </Collapsible>
  </li>
</CommentNode>

<html lang="en" class="page-item" (
  post: LiveView<Post>,
  comments: LiveView<Comment>,
  postVotes: LiveView<PostVote> | null,
  commentVotes: LiveView<CommentVote> | null,
  private draft: Draft = { body: "", open: true, error: "" },
)>
  <Layout title={post.at(0)?.title ?? "post"}>
    <div class="page-shell is-marketing">
      <article e:for={p of post} class="item-post post-row is-bare">
        <VoteButton post={p} votes={postVotes} />
        <div class="post-body">
          <PostTitle post={p} />
          <PostMeta post={p} />
          <p e:if={p.body} class="item-text">{p.body}</p>
        </div>
      </article>

      <form e:if={session.isLoggedIn()} class="item-compose stack is-sm" onsubmit={() => onReply(comments, null, draft)}>
        <Field error={draft.error}>
          <Textarea value={draft.body} rows={4} maxlength={MAX_COMMENT} placeholder="add to the discussion" attrs={{ "aria-label": "comment" }} />
        </Field>
        <div class="row">
          <Button type="submit" variant="primary">comment</Button>
        </div>
      </form>
      <p e:else class="item-signin"><a href="/signin">Sign in</a> to comment.</p>

      <ul class="comment-tree">
        <CommentNode e:for={c of childrenOf(comments, null)} {c} all={comments} votes={commentVotes} />
      </ul>

      <Empty e:if={comments.length === 0} title="No comments yet." description="Start the discussion." />
    </div>
  </Layout>
</html>
