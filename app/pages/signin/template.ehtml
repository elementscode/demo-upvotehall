import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { signin, SEED_HANDLES, SEED_PASSWORD } from "#app/shared/services/auth";

interface SigninForm {
  handle: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.handle, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

function useSeed(form: SigninForm, handle: string) {
  form.handle = handle;
  form.password = SEED_PASSWORD;
  form.error = "";
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { handle: "", password: "", error: "" },
)>
  <Layout title="sign in">
    <div class="page-shell is-marketing signin-layout">
      <form class="stack" onsubmit={() => onSubmit(form)}>
        <h1>Sign in</h1>

        <Alert e:if={form.error} variant="danger" description={form.error} />

        <Field label="username" reserveError={false}>
          <Input name="username"
                 value={form.handle}
                 required
                 attrs={{ id: "handle", autocomplete: "username", autocapitalize: "none", spellcheck: "false" }} />
        </Field>

        <Field label="password" reserveError={false}>
          <Input name="password"
                 type="password"
                 value={form.password}
                 required
                 attrs={{ id: "password", autocomplete: "current-password" }} />
        </Field>

        <Button type="submit" variant="primary">sign in</Button>

        <a href="/signup">need an account? sign up</a>
      </form>

      <Card title="Demo accounts" level={2}>
        <CardContent class="stack">
          <p class="hint">Every seeded account uses the password <code>{SEED_PASSWORD}</code>. Pick one to fill the form.</p>
          <ul class="seed-logins">
            <li e:for={handle of SEED_HANDLES} e:key={(h: string) => h}>
              <Button size="sm" block onclick={() => useSeed(form, handle)}>{handle}</Button>
            </li>
          </ul>
        </CardContent>
      </Card>
    </div>
  </Layout>
</html>
